hal_client_domain(hal_sensors_default, hal_audio)

binder_use(hal_sensors_default)
binder_call(hal_sensors_default, hal_audio_default)
binder_call(hal_sensors_default, system_server)

allow hal_sensors_default device:dir r_dir_perms;

allow hal_sensors_default audio_socket:sock_file rw_file_perms;
allow hal_sensors_default hal_audio_default:unix_stream_socket connectto;
allow hal_sensors_default sensors_device:chr_file rw_file_perms;
allow hal_sensors_default vendor_fingerprint_sysfs:file rw_file_perms;
allow hal_sensors_default vendor_displayfeature_sysfs:file rw_file_perms;
allow hal_sensors_default vendor_displayfeature_sysfs:file rw_file_perms;
allow hal_sensors_default vendor_displayfeature_sysfs:lnk_file r_file_perms;


get_prop(hal_sensors_default, vendor_sensors_prop)

# Allow Sensors hal to find hal_audio_hwservice
hal_client_domain(hal_sensors_default, hal_audio)
allow hal_sensors_default hal_audio_hwservice:hwservice_manager find;

allow hal_sensors_default mtk_hal_composer_ext_service:service_manager find;

hal_client_domain(hal_sensors_default, hal_graphics_allocator)
typeattribute hal_sensors_default hal_mtk_composer_ext_client;
allow hal_sensors_default self:capability2 block_suspend;

allow hal_sensors_default sysfs_tp_virtual_prox:file rw_file_perms;
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file rw_file_perms;
allow hal_sensors_default sysfs_wake_lock:file r_file_perms;
allow vendor_hal_citsensorservice_xiaomi_default hal_sensors_default:binder { call transfer };