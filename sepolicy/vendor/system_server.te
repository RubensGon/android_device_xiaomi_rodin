binder_call(system_server, vendor_hal_citsensorservice_xiaomi_default)
binder_call(system_server, hal_touchfeature_xiaomi_default)
allow system_server sensors_device:chr_file rw_file_perms;
allow system_server vendor_hal_citsensorservice_xiaomi_default:binder call;

# IRQ
allow system_server proc_irq:dir { search };