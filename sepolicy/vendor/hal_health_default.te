r_dir_file(hal_health_default, sysfs_power_supply)

allow hal_health_default sysfs_power_supply:file rw_file_perms;

# Health HAL - Battery and Thermal Sysfs Access
allow hal_health_default sysfs_battery_supply:dir { search open read getattr };
allow hal_health_default sysfs_battery_supply:file { read open getattr };

allow hal_health_default sysfs_ti_battery:dir { search open read getattr };
allow hal_health_default sysfs_ti_battery:file { read open getattr };

allow hal_health_default sysfs_usb_supply:dir { search open read getattr };
allow hal_health_default sysfs_usb_supply:file { read open getattr };

# Allow reading of generic sysfs files
allow hal_health_default sysfs:file { read open getattr };
